<resources>

    <!-- Material You: на Android 12+ цвета берутся из обоев, как в Google Камере -->
    <style name="Theme.My3DCamera" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.My3DCamera.BottomSheetDialog</item>
    </style>

    <!-- Шторки заходят под полосу жестов, иначе под ними видна чёрная системная полоса
         (цвет полосы нужен до Android 15, дальше edge-to-edge и так принудительный) -->
    <style name="ThemeOverlay.My3DCamera.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>
    </style>

    <!-- Экран настроек: фон окна того же цвета, что и экран (виден под полосами при переходе) -->
    <style name="Theme.My3DCamera.Settings">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- Иконка-кнопка с иконкой строго по центру при любом размере -->
    <style name="Widget.My3DCamera.IconButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <!-- Кнопка, которая остаётся нажатой (подстройка, смена глаз, режим) -->
    <style name="Widget.My3DCamera.ToggleIconButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:checkable">true</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <!-- Панель «Настройки видео» в стиле Google Камеры -->
    <style name="Widget.My3DCamera.SheetRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="Widget.My3DCamera.SheetRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="Widget.My3DCamera.SheetRowLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.My3DCamera.SheetRowValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Вариант настройки: квадратная кнопка, выбранная закрашена акцентным цветом -->
    <style name="Widget.My3DCamera.SheetOption" parent="Widget.Material3.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:checkable">true</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/sheet_option_bg</item>
        <item name="android:textColor">@color/sheet_option_text</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Вариант-иконка (как 30/60 fps в Google Камере): иконка строго по центру, цвет — как у текста -->
    <style name="Widget.My3DCamera.SheetOption.Icon">
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">28dp</item>
        <item name="iconTint">@color/sheet_option_text</item>
    </style>

    <!-- Кнопка рядом со спуском: текущий формат видео, открывает панель настроек -->
    <style name="Widget.My3DCamera.FormatButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="ShapeAppearance.My3DCamera.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
