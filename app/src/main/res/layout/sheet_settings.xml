<?xml version="1.0" encoding="utf-8"?>
<!-- Шторка «Настройки»: превью и рамка; остальное — на отдельном экране -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <!-- Отдельный экран с остальными настройками -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/moreSettingsButton"
                style="@style/Widget.My3DCamera.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/more_settings"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Вид превью: оба глаза рядом (SBS) или наложены полупрозрачно, как у обычной камеры -->
        <LinearLayout
            style="@style/Widget.My3DCamera.SheetRow"
            android:layout_marginEnd="8dp">

            <LinearLayout
                style="@style/Widget.My3DCamera.SheetRowText"
                android:paddingStart="0dp">

                <TextView
                    style="@style/Widget.My3DCamera.SheetRowLabel"
                    android:text="@string/preview_title" />

                <TextView
                    android:id="@+id/previewValue"
                    style="@style/Widget.My3DCamera.SheetRowValue" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sideBySideOption"
                style="@style/Widget.My3DCamera.SheetOption.Icon"
                android:contentDescription="@string/preview_side_by_side"
                app:icon="@drawable/ic_preview_side_by_side" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overlayOption"
                style="@style/Widget.My3DCamera.SheetOption.Icon"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/overlay_preview"
                app:icon="@drawable/ic_preview_overlay" />
        </LinearLayout>

        <!-- Рамка вокруг каждого глаза в превью и фото: окно, за которым видна сцена -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/eyeFrameSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/eye_frame"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Плавающее окно: плюс выносит рамку перед сценой -->
        <LinearLayout
            android:id="@+id/frameShiftRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/frame_shift"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/frameShiftValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/frameShiftSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/frame_shift"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="200"
            app:labelBehavior="gone"
            app:tickVisible="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
