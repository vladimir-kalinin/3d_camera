<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <TextureView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/eyeDivider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintTop_toTopOf="@id/preview" />

    <!-- Полупрозрачная карточка поверх превью справа сверху: параметры потока, подписи слева, значения справа -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="#66000000"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/preview"
        app:layout_constraintTop_toTopOf="@id/preview">

        <TextView
            android:id="@+id/statusLabels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/statusValues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/recordingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/record_red"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/warningText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="?attr/colorErrorContainer"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="?attr/colorOnErrorContainer"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/shutterButton" />

    <!-- Ряд спуска: последний снимок · спуск · формат видео; высота — как в Google Камере -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/galleryButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="?attr/colorSurfaceContainerHighest"
        android:contentDescription="@string/open_gallery"
        android:scaleType="center"
        android:src="@drawable/ic_photo_library"
        android:stateListAnimator="@animator/press_scale"
        app:layout_constraintBottom_toBottomOf="@id/shutterButton"
        app:layout_constraintEnd_toStartOf="@id/shutterButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/shutterButton"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.My3DCamera.Thumbnail"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/shutterButton"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginBottom="92dp"
        android:background="@null"
        android:contentDescription="@string/take_photo"
        android:scaleType="fitCenter"
        android:src="@drawable/shutter_photo"
        android:stateListAnimator="@animator/press_scale"
        app:layout_constraintBottom_toTopOf="@id/modeSwitch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Справа от спуска: текущий формат видео, открывает панель настроек (только в режиме видео) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/videoSettingsButton"
        style="@style/Widget.My3DCamera.FormatButton"
        android:layout_width="72dp"
        android:layout_height="60dp"
        android:contentDescription="@string/video_settings"
        app:layout_constraintBottom_toBottomOf="@id/shutterButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/shutterButton"
        app:layout_constraintTop_toTopOf="@id/shutterButton" />

    <!-- Нижний ряд: совмещение глаз · фото/видео · настройки -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/alignmentButton"
        style="@style/Widget.My3DCamera.ToggleIconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:contentDescription="@string/calibration_title"
        app:icon="@drawable/ic_eye_tracking"
        app:layout_constraintBottom_toBottomOf="@id/modeSwitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/modeSwitch" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modeSwitch"
        style="@style/Widget.Material3.MaterialButtonGroup.Connected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/photoModeButton"
            style="@style/Widget.My3DCamera.ToggleIconButton"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:contentDescription="@string/mode_photo"
            app:icon="@drawable/ic_photo_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/videoModeButton"
            style="@style/Widget.My3DCamera.ToggleIconButton"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:contentDescription="@string/mode_video"
            app:icon="@drawable/ic_videocam" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/calibrationButton"
        style="@style/Widget.My3DCamera.ToggleIconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/settings"
        app:icon="@drawable/ic_tune"
        app:layout_constraintBottom_toBottomOf="@id/modeSwitch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/modeSwitch" />

</androidx.constraintlayout.widget.ConstraintLayout>
