<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.My3DCamera"
        tools:targetApi="31">
        <!-- Android 16 на больших экранах игнорирует portrait; камера и рендерер рассчитаны только на портрет.
             Временный отказ, Android 17 его уберёт — тогда нужна поддержка поворота. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name="io.github.vladimir_kalinin.stereocamera.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.vladimir_kalinin.stereocamera.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.My3DCamera.Settings" />
    </application>

</manifest>